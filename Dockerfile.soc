FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN pip install --no-cache-dir "psycopg[binary]==3.2.6" \
    && addgroup -g 10001 -S soc \
    && adduser -u 10001 -S -G soc soc

COPY --chown=10001:10001 src /app/src

USER 10001:10001

CMD ["python", "-m", "soc.dashboard"]
