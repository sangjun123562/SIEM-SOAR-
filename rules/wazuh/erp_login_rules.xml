<group name="erp,authentication_failures,">
  <rule id="100101" level="5">
    <decoded_as>json</decoded_as>
    <field name="source">^erp$</field>
    <field name="event_type">^login_failed$</field>
    <field name="client_ip_trusted">^true$</field>
    <description>ERP trusted client_ip login failure ($(username) from $(client_ip)).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>username</same_field>
    <same_field>client_ip</same_field>
    <description>Repeated Trusted ERP Login Failures: 5 failures in 300s (RULE-ERP-LOGIN-BRUTE-001).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>
</group>
