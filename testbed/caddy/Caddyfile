# 게이트웨이 뒤의 HTTPS 리버스 프록시.
# - X-Request-ID / X-Client-IP는 클라이언트가 보낸 값을 무시하고 Caddy가 직접 덮어쓴다(header_up은 값을 교체함).
# - 원본/런타임 로그를 쓰기 전에 query·요청/응답 헤더를 제거하고 변환기는 계약 필드만 추출한다.
# - 4일 차부터: /echo 는 1~3일 차 시험용 임시 서버, 그 밖의 모든 경로는 ERP(Flask).
{
	admin off
	log waf_matches {
		include http.handlers.waf.matches
		output file /var/log/caddy/waf.jsonl {
			roll_size 10MiB
			roll_keep 2
		}
		format json
	}
	# Sanitize runtime/error request records before encoding too.
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
				request>headers delete
				resp_headers delete
			}
		}
	}
	skip_install_trust          # 컨테이너 안 시스템 신뢰 저장소를 건드리지 않음
	auto_https disable_redirects
	local_certs                 # 시험망에는 인터넷이 없으므로 Caddy 내장(내부) CA로 인증서 발급
}

# 두 업스트림에 똑같이 붙이는 헤더(클라이언트 값을 덮어씀)
(erp_waf) {
	coraza_waf {
		load_owasp_crs
		tx_id_req_header X-Request-ID
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			SecRuleEngine {$CORAZA_RULE_ENGINE:DetectionOnly}
			SecAuditEngine Off
			SecDebugLogLevel 0
			SecResponseBodyAccess Off
			Include @owasp_crs/*.conf
			SecRuleRemoveById 920350
			SecRule TX:BLOCKING_INBOUND_ANOMALY_SCORE "@gt 0" "id:100100,phase:5,pass,t:none,log"
		`
	}
}

(upstream_headers) {
	header_up X-Request-ID {http.request.uuid}
	header_up X-Client-IP  {http.request.remote.host}
}

https://172.28.20.5:8443 {
	tls internal

	log {
		output file /var/log/caddy/access.json {
			roll_size 10MiB
			roll_keep 2
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
				request>headers delete
				resp_headers delete
			}
		}
	}
	# 서버로 보내는 값과 같은 값을 로그에도 남긴다(요청 ID는 요청마다 하나).
	log_append request_id {http.request.uuid}
	log_append client_ip  {http.request.remote.host}

	handle /echo {
		reverse_proxy 172.28.20.10:8080 {
			import upstream_headers
		}
	}
	handle /internal/* {
		respond 404
	}
	@erp_login {
		method POST
		path /api/login
	}
	handle @erp_login {
		@missing_length not header Content-Length *
		respond @missing_length "Content-Length required" 411
		route {
			request_header X-Request-ID {http.request.uuid}
			request_body {
				max_size 8192
			}
			import erp_waf
			reverse_proxy 172.28.20.20:8000 {
				import upstream_headers
			}
		}
	}
	handle_errors 413 {
		log_append waf_rule_id ERP-LOGIN-BODY-LIMIT
		respond "Request body too large" 413
	}
	handle {
		route {
			request_header X-Request-ID {http.request.uuid}
			import erp_waf
			reverse_proxy 172.28.20.20:8000 {
				import upstream_headers
			}
		}
	}
}
